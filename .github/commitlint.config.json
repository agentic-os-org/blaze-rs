{
  "rules": {
    "type-empty": [
      2,
      "never"
    ],
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "refactor",
        "perf",
        "docs",
        "chore",
        "test",
        "ci",
        "build",
        "style",
        "revert"
      ]
    ],
    "scope-empty": [
      2,
      "always"
    ],
    "subject-empty": [
      2,
      "never"
    ],
    "header-max-length": [
      2,
      "always",
      50
    ],
    "subject-case": [
      2,
      "never",
      [
        "sentence-case",
        "start-case",
        "pascal-case",
        "upper-case"
      ]
    ],
    "subject-full-stop": [
      2,
      "never",
      "."
    ]
  }
}
